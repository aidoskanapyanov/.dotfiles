#!/usr/bin/env bash

# Get list of active tmux sessions
session=$(tmux list-sessions -F "#S" | fzf)

# If user cancels fzf
if [[ -z $session ]]; then
    exit 0
fi

# If inside tmux, switch; otherwise, attach
if [[ -n $TMUX ]]; then
    tmux switch-client -t "$session"
else
    tmux attach-session -t "$session"
fi
